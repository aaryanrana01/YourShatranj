# ---------------------------------------------------------------------------
# Copy to apps/server/.env for local development, or to .env (repo root) for
# docker compose. Never commit the real file.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

# --- Local development (apps/server/.env) ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://chess:chess@localhost:5432/chess
REDIS_URL=redis://localhost:6379
APP_ORIGIN=http://localhost:5173

# --- Secrets (required everywhere, at least 32 characters, different from each other) ---
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-1
REFRESH_TOKEN_SECRET=replace-me-with-a-long-random-string-2

# chess.com asks API users to include a contact in the User-Agent (an email or a URL).
CHESSCOM_CONTACT=you@example.com

# Only needed when you run more than one server instance.
REDIS_ADAPTER=false

# --- docker compose only (repo-root .env) ---
# Your domain, e.g. mychess.duckdns.org (must point at the server's IP).
DOMAIN=mychess.example.com
POSTGRES_PASSWORD=replace-me-with-a-long-random-string-3
